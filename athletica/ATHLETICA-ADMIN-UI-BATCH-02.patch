--- /dev/null
+++ b/rollout/src/components/admin/admin-workspace.css
@@ -0,0 +1,265 @@
+.admin-workspace-header,
+.admin-workspace-header * {
+  box-sizing: border-box;
+}
+
+.admin-workspace-header {
+  min-height: 76px;
+  padding: 0 clamp(20px, 4vw, 56px);
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: 24px;
+  border-bottom: 1px solid #252525;
+  background: #050505;
+}
+
+.admin-workspace-brand {
+  display: inline-flex;
+  width: fit-content;
+  align-items: center;
+  gap: 11px;
+  color: #fff;
+  text-decoration: none;
+}
+
+.admin-workspace-brand__mark {
+  width: 34px;
+  height: 34px;
+  display: grid;
+  place-items: center;
+  background: #d1fd40;
+  color: #050505;
+  font-size: 18px;
+  font-weight: 950;
+  font-style: italic;
+}
+
+.admin-workspace-brand strong,
+.admin-workspace-brand small {
+  display: block;
+}
+
+.admin-workspace-brand strong {
+  font-size: 12px;
+  font-weight: 900;
+  letter-spacing: .16em;
+}
+
+.admin-workspace-brand small {
+  margin-top: 4px;
+  color: #8c8c8c;
+  font-size: 8px;
+  font-weight: 750;
+  letter-spacing: .22em;
+}
+
+.admin-workspace-nav {
+  display: flex;
+  align-items: center;
+  gap: 34px;
+}
+
+.admin-workspace-nav a {
+  padding: 29px 0 27px;
+  border-bottom: 2px solid transparent;
+  color: #929292;
+  font-size: 11px;
+  font-weight: 750;
+  letter-spacing: .1em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.admin-workspace-nav a:hover,
+.admin-workspace-nav a:focus-visible {
+  border-color: #d1fd40;
+  color: #fff;
+}
+
+.admin-workspace-header form {
+  justify-self: end;
+}
+
+.admin-workspace-signout {
+  min-height: 36px;
+  padding: 0 14px;
+  border: 1px solid #363636;
+  background: transparent;
+  color: #b7b7b7;
+  font-size: 10px;
+  font-weight: 750;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  cursor: pointer;
+}
+
+.admin-workspace-signout:hover {
+  border-color: #d1fd40;
+  color: #d1fd40;
+}
+
+.admin-analytics-page {
+  width: min(100% - 48px, 1440px);
+  margin: 0 auto;
+  padding: 46px 0 90px;
+  color: #fff;
+}
+
+.admin-analytics-heading {
+  display: flex;
+  align-items: end;
+  justify-content: space-between;
+  gap: 20px;
+  margin-bottom: 30px;
+}
+
+.admin-analytics-eyebrow {
+  margin: 0 0 10px;
+  color: #d1fd40;
+  font-size: 10px;
+  font-weight: 850;
+  letter-spacing: .2em;
+  text-transform: uppercase;
+}
+
+.admin-analytics-title {
+  margin: 0;
+  color: #fff;
+  font-size: clamp(34px, 5vw, 56px);
+  font-weight: 900;
+  letter-spacing: -.065em;
+  line-height: .95;
+  text-transform: uppercase;
+}
+
+.admin-analytics-subtitle {
+  max-width: 470px;
+  margin: 13px 0 0;
+  color: #929292;
+  font-size: 13px;
+  line-height: 1.6;
+}
+
+.admin-live-indicator {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 9px 12px;
+  border: 1px solid #303030;
+  color: #aaa;
+  font-size: 9px;
+  font-weight: 800;
+  letter-spacing: .12em;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
+.admin-live-indicator::before {
+  content: "";
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: #777;
+}
+
+.admin-live-indicator[data-live="true"] {
+  border-color: rgb(209 253 64 / 35%);
+  color: #d1fd40;
+}
+
+.admin-live-indicator[data-live="true"]::before {
+  background: #d1fd40;
+  box-shadow: 0 0 0 4px rgb(209 253 64 / 12%);
+}
+
+.admin-metric-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 14px;
+}
+
+.admin-metric-card {
+  min-height: 150px;
+  padding: 22px;
+  border: 1px solid #292929;
+  background: #090909;
+}
+
+.admin-metric-card__label {
+  color: #929292;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .15em;
+  text-transform: uppercase;
+}
+
+.admin-metric-card__value {
+  margin-top: 22px;
+  color: #fff;
+  font-size: clamp(32px, 4vw, 48px);
+  font-weight: 900;
+  letter-spacing: -.06em;
+  line-height: 1;
+}
+
+.admin-metric-card--accent .admin-metric-card__value {
+  color: #d1fd40;
+}
+
+.admin-analytics-section {
+  margin-top: 34px;
+}
+
+.admin-analytics-section__heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  margin-bottom: 14px;
+}
+
+.admin-analytics-section__heading h2 {
+  margin: 0;
+  color: #fff;
+  font-size: 15px;
+  font-weight: 850;
+  letter-spacing: .02em;
+  text-transform: uppercase;
+}
+
+.admin-analytics-section__heading span {
+  color: #777;
+  font-size: 10px;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+}
+
+.admin-source-grid,
+.admin-payout-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+}
+
+.admin-source-card,
+.admin-payout-card,
+.admin-analytics-empty {
+  padding: 19px;
+  border: 1px solid #292929;
+  background: #090909;
+}
+
+.admin-source-card__name,
+.admin-payout-card__name {
+  color: #929292;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .13em;
+  text-transform: uppercase;
+}
+
+.admin-source-card__counts {
+  display: flex;
+  gap: 22px;
+  margin-top: 16px;
+}
+
+.admin-source-card__counts strong,
+.admin-payout-card__value {
+  display: block;
+  color: #fff;
+  font-size: 21px;
+  font-weight: 850;
+}
+
+.admin-source-card__counts small {
+  display: block;
+  margin-top: 4px;
+  color: #777;
+  font-size: 9px;
+  text-transform: uppercase;
+}
+
+.admin-payout-card__value {
+  margin-top: 15px;
+  color: #d1fd40;
+}
+
+.admin-analytics-empty {
+  color: #777;
+  font-size: 12px;
+  line-height: 1.6;
+}
+
+.admin-analytics-loading {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 14px;
+}
+
+.admin-analytics-loading span {
+  height: 150px;
+  background: #101010;
+  animation: admin-pulse 1.3s ease-in-out infinite alternate;
+}
+
+@keyframes admin-pulse {
+  from { opacity: .4; }
+  to { opacity: 1; }
+}
+
+@media (max-width: 760px) {
+  .admin-workspace-header {
+    min-height: 68px;
+    grid-template-columns: 1fr auto;
+    padding-inline: 16px;
+  }
+
+  .admin-workspace-nav {
+    display: none;
+  }
+
+  .admin-analytics-page {
+    width: calc(100% - 32px);
+    padding-top: 34px;
+  }
+
+  .admin-analytics-heading {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .admin-metric-grid,
+  .admin-source-grid,
+  .admin-payout-grid,
+  .admin-analytics-loading {
+    grid-template-columns: 1fr;
+  }
+
+  .admin-metric-card {
+    min-height: 118px;
+  }
+
+  .admin-metric-card__value {
+    margin-top: 15px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .admin-workspace-header *,
+  .admin-analytics-page * {
+    animation-duration: .01ms !important;
+    transition-duration: .01ms !important;
+  }
+}
