+        <span className="admin-workspace-brand__mark">A</span>
+        <span><strong>ATHLETICA</strong><small>OPERATIONS</small></span>
+      </Link>
+      <nav className="admin-workspace-nav" aria-label="Admin navigation">
+        <Link href="/admin/products">Products</Link>
+        <Link href="/admin/analytics">Analytics</Link>
+      </nav>
+      <form action="/api/admin/auth/signout" method="POST">
+        <button className="admin-workspace-signout" type="submit">Sign out</button>
+      </form>
+    </header>
+  );
+}
diff --git a/rollout/src/components/admin/admin-workspace.css b/rollout/src/components/admin/admin-workspace.css
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/rollout/src/components/admin/admin-workspace.css
@@ -0,0 +1,232 @@
+.admin-workspace-header,
+.admin-workspace-header * {
+  box-sizing: border-box;
+}
+
+.admin-workspace-header {
+  min-height: 76px;
+  padding: 0 clamp(20px, 4vw, 56px);
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: 24px;
+  border-bottom: 1px solid #252525;
+  background: #050505;
+}
+
+.admin-workspace-brand {
+  display: inline-flex;
+  width: fit-content;
+  align-items: center;
+  gap: 11px;
+  color: #fff;
+  text-decoration: none;
+}
+
+.admin-workspace-brand__mark {
+  width: 34px;
+  height: 34px;
+  display: grid;
+  place-items: center;
+  background: #d1fd40;
+  color: #050505;
+  font-size: 18px;
+  font-weight: 950;
+  font-style: italic;
+}
+
+.admin-workspace-brand strong,
+.admin-workspace-brand small {
+  display: block;
+}
+
+.admin-workspace-brand strong {
+  font-size: 12px;
+  font-weight: 900;
+  letter-spacing: .16em;
+}
+
+.admin-workspace-brand small {
+  margin-top: 4px;
+  color: #8c8c8c;
+  font-size: 8px;
+  font-weight: 750;
+  letter-spacing: .22em;
+}
+
+.admin-workspace-nav {
+  display: flex;
+  align-items: center;
+  gap: 34px;
+}
+
+.admin-workspace-nav a {
+  padding: 29px 0 27px;
+  border-bottom: 2px solid transparent;
+  color: #929292;
+  font-size: 11px;
+  font-weight: 750;
+  letter-spacing: .1em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.admin-workspace-nav a:hover,
+.admin-workspace-nav a:focus-visible {
+  border-color: #d1fd40;
+  color: #fff;
+}
+
+.admin-workspace-header form {
+  justify-self: end;
+}
+
+.admin-workspace-signout {
+  min-height: 36px;
+  padding: 0 14px;
+  border: 1px solid #363636;
+  background: transparent;
+  color: #b7b7b7;
+  font-size: 10px;
+  font-weight: 750;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  cursor: pointer;
+}
+
+.admin-workspace-signout:hover {
+  border-color: #d1fd40;
+  color: #d1fd40;
+}
+
+.admin-analytics-page {
+  width: min(100% - 48px, 1440px);
+  min-height: 75vh;
+  margin: 0 auto;
+  padding: 46px 0 90px;
+  color: #fff;
+}
+
+.admin-analytics-heading {
+  display: flex;
+  align-items: end;
+  justify-content: space-between;
+  gap: 20px;
+  margin-bottom: 30px;
+}
+
+.admin-analytics-eyebrow {
+  margin: 0 0 10px;
+  color: #d1fd40;
+  font-size: 10px;
+  font-weight: 850;
+  letter-spacing: .2em;
+  text-transform: uppercase;
+}
+
+.admin-analytics-title {
+  margin: 0;
+  color: #fff;
+  font-size: clamp(34px, 5vw, 56px);
+  font-weight: 900;
+  letter-spacing: -.065em;
+  line-height: .95;
+  text-transform: uppercase;
+}
+
+.admin-analytics-subtitle {
+  max-width: 470px;
+  margin: 13px 0 0;
+  color: #929292;
+  font-size: 13px;
+  line-height: 1.6;
+}
+
+/* The existing analytics data component keeps its real SSE/data behavior.
+   These selectors provide the visual treatment without changing that logic. */
+.admin-analytics-page .space-y-6 {
+  display: grid;
+  gap: 28px;
+}
+
+.admin-analytics-page .text-sm.text-neutral-400 {
+  color: #d1fd40;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .12em;
+  text-transform: uppercase;
+}
+
+.admin-analytics-page .grid.grid-cols-3 {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 14px;
+}
+
+.admin-analytics-page .rounded.border.border-neutral-800 {
+  min-height: 126px;
+  padding: 20px;
+  border: 1px solid #292929;
+  border-radius: 0;
+  background: #090909;
+}
+
+.admin-analytics-page .rounded.border.border-neutral-800 .text-sm {
+  color: #929292;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .13em;
+  text-transform: uppercase;
+}
+
+.admin-analytics-page .rounded.border.border-neutral-800 .text-white {
+  margin-top: 17px;
+  color: #d1fd40;
+  font-size: 27px;
+  font-weight: 900;
+  letter-spacing: -.05em;
+}
+
+.admin-analytics-page h2 {
+  margin: 0 0 14px;
+  color: #fff;
+  font-size: 14px;
+  font-weight: 850;
+  letter-spacing: .04em;
+  text-transform: uppercase;
+}
+
+.admin-analytics-page .flex.gap-4 {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+}
+
+.admin-analytics-page > p.text-neutral-400 {
+  padding: 28px;
+  border: 1px solid #292929;
+  background: #090909;
+  color: #929292;
+  font-size: 13px;
+}
+
+@media (max-width: 760px) {
+  .admin-workspace-header {
+    min-height: 68px;
+    grid-template-columns: 1fr auto;
+    padding-inline: 16px;
+  }
+
+  .admin-workspace-nav {
+    display: none;
+  }
+
+  .admin-analytics-page {
+    width: calc(100% - 32px);
+    padding-top: 34px;
+  }
+
+  .admin-analytics-page .grid.grid-cols-3,
+  .admin-analytics-page .flex.gap-4 {
+    grid-template-columns: 1fr;
+  }
+}
