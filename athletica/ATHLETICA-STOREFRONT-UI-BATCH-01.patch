+.storefront-header,
+.storefront-header * {
+  box-sizing: border-box;
+}
+
+.storefront-header {
+  position: relative;
+  z-index: 10;
+  width: 100%;
+  border-bottom: 1px solid #292929;
+  background: #050505;
+}
+
+.storefront-header__inner {
+  width: min(100% - 48px, 1440px);
+  min-height: 82px;
+  margin: 0 auto;
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: 28px;
+}
+
+.storefront-wordmark {
+  width: fit-content;
+  color: #f7f7f7;
+  font-size: 20px;
+  font-weight: 900;
+  letter-spacing: .16em;
+  line-height: 1;
+  text-decoration: none;
+}
+
+.storefront-wordmark span {
+  color: #d1fd40;
+}
+
+.storefront-nav {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: clamp(22px, 3vw, 46px);
+}
+
+.storefront-nav__link {
+  color: #b9b9b9;
+  font-size: 12px;
+  font-weight: 650;
+  letter-spacing: .08em;
+  text-decoration: none;
+  text-transform: uppercase;
+  transition: color 160ms ease;
+}
+
+.storefront-nav__link:hover,
+.storefront-nav__link:focus-visible {
+  color: #d1fd40;
+}
+
+.storefront-header__action {
+  justify-self: end;
+  display: inline-flex;
+  min-height: 42px;
+  align-items: center;
+  justify-content: center;
+  gap: 18px;
+  padding: 0 17px;
+  border: 1px solid #d1fd40;
+  color: #d1fd40;
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: .07em;
+  text-decoration: none;
+  text-transform: uppercase;
+  transition: color 160ms ease, background 160ms ease;
+}
+
+.storefront-header__action:hover {
+  color: #050505;
+  background: #d1fd40;
+}
+
+.storefront-home-intro {
+  width: min(100% - 48px, 1440px);
+  margin: 0 auto;
+  padding: clamp(48px, 8vw, 108px) 0 18px;
+}
+
+.storefront-eyebrow {
+  margin: 0 0 16px;
+  color: #d1fd40;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .22em;
+  text-transform: uppercase;
+}
+
+.storefront-home-title {
+  max-width: 900px;
+  margin: 0;
+  color: #f7f7f7;
+  font-size: clamp(44px, 8vw, 104px);
+  font-weight: 900;
+  letter-spacing: -.075em;
+  line-height: .92;
+  text-transform: uppercase;
+}
+
+.storefront-home-title span {
+  color: #d1fd40;
+}
+
+.storefront-home-copy {
+  max-width: 520px;
+  margin: 24px 0 0;
+  color: #a7a7a7;
+  font-size: 15px;
+  line-height: 1.7;
+}
+
+.storefront-section-heading {
+  width: min(100% - 48px, 1440px);
+  margin: 38px auto 0;
+  display: flex;
+  align-items: end;
+  justify-content: space-between;
+  gap: 20px;
+}
+
+.storefront-section-heading h2 {
+  margin: 0;
+  color: #f7f7f7;
+  font-size: clamp(24px, 3vw, 38px);
+  font-weight: 850;
+  letter-spacing: -.045em;
+  text-transform: uppercase;
+}
+
+.storefront-section-heading a {
+  color: #d1fd40;
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: .08em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.shop-page {
+  width: min(100% - 48px, 1440px);
+  min-height: 70vh;
+  margin: 0 auto;
+  padding: clamp(44px, 6vw, 76px) 0 90px;
+}
+
+.shop-page__eyebrow {
+  margin: 0 0 12px;
+  color: #d1fd40;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .2em;
+  text-transform: uppercase;
+}
+
+.shop-page__title {
+  margin: 0;
+  color: #fff;
+  font-size: clamp(42px, 7vw, 76px);
+  font-weight: 900;
+  letter-spacing: -.065em;
+  line-height: .95;
+  text-transform: uppercase;
+}
+
+.shop-page__description {
+  max-width: 560px;
+  margin: 18px 0 38px;
+  color: #a6a6a6;
+  font-size: 14px;
+  line-height: 1.7;
+}
+
+.shop-page__results {
+  min-height: 360px;
+  border-top: 1px solid #333;
+  padding-top: 26px;
+}
+
+.shop-page__loading {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 18px;
+}
+
+.shop-page__skeleton {
+  aspect-ratio: 4 / 5;
+  background: #101010;
+  animation: shop-pulse 1.4s ease-in-out infinite alternate;
+}
+
+@keyframes shop-pulse {
+  from { opacity: .45; }
+  to { opacity: 1; }
+}
+
+@media (max-width: 760px) {
+  .storefront-header__inner {
+    width: min(100% - 32px, 1440px);
+    min-height: 70px;
+    grid-template-columns: 1fr auto;
+    gap: 14px;
+  }
+
+  .storefront-nav {
+    display: none;
+  }
+
+  .storefront-header__action {
+    min-height: 38px;
+    gap: 10px;
+    padding: 0 11px;
+    font-size: 9px;
+  }
+
+  .storefront-home-intro,
+  .storefront-section-heading,
+  .shop-page {
+    width: min(100% - 32px, 1440px);
+  }
+
+  .storefront-home-intro {
+    padding-top: 54px;
+  }
+
+  .storefront-home-copy {
+    font-size: 14px;
+  }
+
+  .shop-page__loading {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 12px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .storefront-header *,
+  .shop-page * {
+    animation-duration: .01ms !important;
+    transition-duration: .01ms !important;
+  }
+}
