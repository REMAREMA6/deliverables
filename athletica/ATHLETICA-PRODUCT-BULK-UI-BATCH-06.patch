+          ) : loading && items.length === 0 ? (
+            <div className="admin-skeleton">
+              {Array.from({ length: 6 }).map((_, i) => (
+                <div className="admin-skeleton__row" key={i} />
+              ))}
+            </div>
+          ) : showSearchEmpty ? (
+            <div className="admin-state">
+              <h2 className="admin-state__title">NO PRODUCTS FOUND</h2>
+              <p className="admin-state__text">Try another search term or clear the filter.</p>
+              <button
+                type="button"
+                className="admin-btn"
+                onClick={() => {
+                  setSearch('');
+                  setSearchDebounced('');
+                  resetToFirstPage();
+                }}
+              >
+                CLEAR SEARCH
+              </button>
+            </div>
+          ) : showCatalogEmpty ? (
+            <div className="admin-state">
+              <h2 className="admin-state__title">No products yet.</h2>
+              <button type="button" className="admin-btn admin-btn--primary" onClick={() => setEditorOpen(true)}>
+                + ADD PRODUCT
+              </button>
+            </div>
+          ) : (
+            <div className="admin-table-wrap">
+              <table className="admin-table">
+                <thead>
+                  <tr>
+                    <th scope="col"><input type="checkbox" aria-label="Select all visible products" checked={allVisibleSelected} onChange={() => setSelectedIds((current) => allVisibleSelected ? current.filter((id) => !items.some((item) => item.id === id)) : [...new Set([...current, ...items.map((item) => item.id)])])} /></th>
+                    <th scope="col">Product</th>
+                    <th scope="col">ID</th>
+                    <th scope="col">Status</th>
+                    <th scope="col">Price</th>
+                    <th scope="col">Tags</th>
+                    <th scope="col">Actions</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {items.map((product) => {
+                    const rowBusy = busy?.id === product.id;
+                    return (
+                      <tr key={product.id}>
+                        <td><input type="checkbox" aria-label={`Select ${product.name}`} checked={selectedIds.includes(product.id)} onChange={() => toggleSelected(product.id)} /></td>
+                        <td className="admin-product-cell">
+                          <img
+                            className="admin-thumb"
+                            src={product.main_image ?? FALLBACK_PRODUCT_IMAGE}
+                            alt=""
+                          />
+                          <div className="admin-product-meta">
+                            <Link className="admin-product-name" href={`/admin/products/${product.id}/edit`}>
+                              {product.name}
+                            </Link>
+                            {product.color && <span className="admin-product-color">{product.color}</span>}
+                          </div>
+                        </td>
+                        <td>
+                          <span className="admin-id">{product.id}</span>
+                        </td>
+                        <td>
+                          <span className={`admin-status admin-status--${product.status}`}>{product.status}</span>
+                        </td>
+                        <td>{typeof product.price === 'number' ? `$${product.price.toFixed(2)}` : '—'}</td>
+                        <td>
+                          {product.tags && product.tags.length > 0 && (
+                            <div className="admin-tags">
+                              {product.tags.slice(0, 3).map((tag) => (
+                                <span className="admin-tag" key={tag}>
+                                  {tag}
+                                </span>
+                              ))}
+                              {product.tags.length > 3 && <span className="admin-tag">+{product.tags.length - 3}</span>}
+                            </div>
+                          )}
+                        </td>
+                        <td>
+                          <div className="admin-actions">
+                            <Link className="admin-action admin-action--link" href={`/admin/products/${product.id}/edit`}>
+                              Edit
+                            </Link>
+                            <button
+                              type="button"
+                              className="admin-action"
+                              disabled={rowBusy}
+                              onClick={() => toggleStatus(product)}
+                            >
+                              {rowBusy && busy?.action === 'status'
+                                ? product.status === 'published'
+                                  ? 'Unpublishing...'
+                                  : 'Publishing...'
+                                : product.status === 'published'
+                                  ? 'Unpublish'
+                                  : 'Publish'}
+                            </button>
+                            <button
+                              type="button"
+                              className="admin-action admin-action--danger"
+                              disabled={rowBusy}
+                              onClick={() => setDeleteTarget(product)}
+                            >
+                              {rowBusy && busy?.action === 'delete' ? 'Deleting...' : 'Delete'}
+                            </button>
+                          </div>
+                        </td>
+                      </tr>
+                    );
+                  })}
+                </tbody>
+              </table>
+
+              <div className="admin-pagination">
+                <span className="admin-pagination__info">
+                  Showing {from} to {to} of {total} products
+                </span>
+                <div className="admin-pagination__controls">
+                  <button
+                    type="button"
+                    className="admin-btn"
+                    disabled={page <= 1 || loading}
+                    onClick={() => setPage((p) => p - 1)}
+                  >
+                    Previous
+                  </button>
+                  <button
+                    type="button"
+                    className="admin-btn"
+                    disabled={page >= totalPages || loading}
+                    onClick={() => setPage((p) => p + 1)}
+                  >
+                    Next
+                  </button>
+                </div>
+              </div>
+            </div>
+          )}
+        </main>
+      </div>
+
+      {editorOpen && (
+        <ProductEditor
+          mode="create"
+          onClose={() => setEditorOpen(false)}
+          onSaved={() => {
+            setEditorOpen(false);
+            push('success', 'Product created');
+            setReloadKey((k) => k + 1);
+          }}
+        />
+      )}
+
+      <ConfirmDialog
+        open={deleteTarget !== null}
+        title={deleteTarget ? `Delete "${deleteTarget.name}"?` : ''}
+        description="This will permanently remove the product from the catalog."
+        confirmLabel="Delete Product"
+        busy={busy?.action === 'delete' && busy?.id === deleteTarget?.id}
+        onCancel={() => setDeleteTarget(null)}
+        onConfirm={confirmDelete}
+      />
+
+      <ToastViewport toasts={toasts} onDismiss={dismiss} />
+    </div>
+  );
+}
